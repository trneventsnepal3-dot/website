DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/neondb?sslmode=require&channel_binding=require"
ADMIN_PASSWORD_HASH="your-scrypt-password-hash"
AWS_ENDPOINT_URL_S3="your-s3-compatible-endpoint"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-2"
NEON_MEDIA_BUCKET=media
NEON_SONG_BUCKET=song
NEON_HERO_BUCKET=herosectionvideo

# Optional Supabase backend. Set DB_PRIMARY=supabase to use it immediately;
# otherwise it is used automatically when Neon is unavailable or over quota.
DB_PRIMARY=neon
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "storage:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/storage.mjs check",
    "storage:cors": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/storage.mjs cors",
    "storage:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/storage.mjs sync",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"

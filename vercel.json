{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/router?__trn_path=:path*" },
    { "source": "/event/:id", "destination": "/api/router?__trn_path=event/:id" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "functions": {
    "api/router.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/media/hero-video.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-poster.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
